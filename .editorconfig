# EditorConfig for consistent coding standards across all languages
# See https://editorconfig.org for more information

root = true

# Default settings for all files
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

# JSON files
[*.json]
indent_style = space
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Go files
[*.go]
indent_style = tab
indent_size = 4

# Rust files
[*.rs]
indent_style = space
indent_size = 4
max_line_length = 100

# C files
[*.{c,h}]
indent_style = space
indent_size = 4
max_line_length = 100

# Makefile
[Makefile]
indent_style = tab
indent_size = 4

# CMake
[CMakeLists.txt]
indent_style = space
indent_size = 2

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2

# Git config files
[.git*]
indent_style = space
indent_size = 2
